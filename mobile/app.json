{
  "expo": {
    "name": "Vietnam Pagodas",
    "slug": "vietnam-pagodas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vietnampagodas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#451a03"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vietnampagodas.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used only to sort pagodas by distance from you.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vietnampagodas.app",
      "adaptiveIcon": {
        "backgroundColor": "#451a03",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used only to sort pagodas by distance from you."
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "light",
          "backgroundColor": "#451a03"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
