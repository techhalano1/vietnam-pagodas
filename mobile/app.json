{
  "expo": {
    "name": "Vietnam Pagodas",
    "slug": "vietnam-pagodas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vietnampagodas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vietnampagodas.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used only to sort pagodas by distance from you.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vietnampagodas.app",
      "adaptiveIcon": {
        "backgroundColor": "#D4A017",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used only to sort pagodas by distance from you."
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "auto",
          "backgroundColor": "#FFFDF7"
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFDF7",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#14110B"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
